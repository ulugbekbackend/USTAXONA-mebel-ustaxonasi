# .env faylni shu nusxadan yarating:  cp .env.example .env
# Kalit yaratish: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=almashtiring-50-belgili-tasodifiy-kalit
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
# sitemap.xml havolalari uchun saytning ommaviy manzili
SITE_URL=http://localhost:5173

# Lokal ishlab chiqish uchun sqlite (PostgreSQL shart emas).
# PostgreSQL uchun qatorni o'chiring va pastdagi DB_* ni to'ldiring.
DB_ENGINE=sqlite

# PostgreSQL (Docker'da DB_* docker-compose.yml orqali root .env'dan beriladi)
DB_NAME=ustaxona
DB_USER=ustaxona
DB_USER_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# HTTPS redirect, secure cookie, HSTS. Default: DEBUG=False bo'lsa yoqiladi.
# USE_HTTPS=False

# Oldidagi reverse-proxy'lar soni (throttling to'g'ri IP'ni ko'rishi uchun).
# Docker'da docker-compose.yml o'zi 1 qiladi.
NUM_PROXIES=0

# Telegram bot (yangi buyurtma xabari uchun)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Media fayllar
MEDIA_ROOT=media
