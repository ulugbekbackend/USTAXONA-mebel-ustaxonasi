# docker-compose uchun (root). Nusxa oling:  cp .env.example .env
POSTGRES_DB=ustaxona
POSTGRES_USER=ustaxona
POSTGRES_PASSWORD=almashtiring-uzun-tasodifiy-parol

# Sayt domeni (hali olinmagan — example.com placeholder). Olingach shu yerga yozing.
# ALLOWED_HOSTS, CSRF va Traefik qoidalari shundan quriladi.
DOMAIN=example.com

# Sayt HTTPS (Traefik + sertifikat) orqali ochilsa True.
# Lokal sinov http://localhost:8080 uchun False.
USE_HTTPS=False

# sitemap.xml va robots.txt havolalari uchun saytning ommaviy manzili.
# Domen olingach: SITE_URL=https://<DOMAIN>
SITE_URL=http://localhost:8080
